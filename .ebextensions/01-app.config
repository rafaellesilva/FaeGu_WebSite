# Configuração do Elastic Beanstalk para a Fa & Gu.
# O banco é SQLite (um arquivo), então o site precisa rodar em UMA instância só,
# e os deploys não podem subir uma segunda instância em paralelo.
option_settings:
  aws:elasticbeanstalk:application:environment:
    NODE_ENV: production
    DATABASE_FILE: /var/app/data/site.db
    # 2 = load balancer + nginx. Em ambiente "instância única" (sem load balancer), troque para 1.
    TRUST_PROXY: "2"
  aws:autoscaling:asg:
    MinSize: 1
    MaxSize: 1
  aws:elasticbeanstalk:command:
    DeploymentPolicy: AllAtOnce
  aws:autoscaling:updatepolicy:rollingupdate:
    RollingUpdateEnabled: false
  aws:elasticbeanstalk:managedactions:
    # Atualizações automáticas de plataforma criam uma instância nova em paralelo; faça-as manualmente.
    ManagedActionsEnabled: false
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /api/health

container_commands:
  01_data_dir:
    # Pasta fora de /var/app/current, que é apagada a cada deploy.
    command: mkdir -p /var/app/data && chown webapp:webapp /var/app/data && chmod 700 /var/app/data
