# Copie para .env (desenvolvimento). Na AWS, configure estas variáveis no console do
# Elastic Beanstalk em Configuração > Atualizações, monitoramento e logs > Propriedades do ambiente.

# Segredo das sessões. Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# Primeiro administrador: criado só se o e-mail ainda não existir no banco.
# Depois do primeiro login, pode apagar ADMIN_PASSWORD do ambiente.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador

# Backup do banco no S3 (obrigatório na AWS). Deixe vazio em desenvolvimento.
BACKUP_BUCKET=
# Região do bucket, ex.: sa-east-1 (São Paulo) ou us-east-1
AWS_REGION=
BACKUP_PREFIX=backups
BACKUP_INTERVAL_MINUTES=15

# Opcionais
# PORT=3000
# DATABASE_FILE=./data/site.db
# COOKIE_SECURE=false   # só para testar a AWS sem HTTPS; volte para true (ou apague) depois
# CLIENT_ORIGIN=        # só se o front-end ficar em outro domínio que a API
# TRUST_PROXY=1
